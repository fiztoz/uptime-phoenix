# syntax=docker/dockerfile:1
# Lightweight phoenix-web image for local K8s split deploy.
# Requires `cd web && bun run build` before building.
#
#   docker buildx build --build-context webdist=web/dist \
#     -f deploy/k8s-local/Dockerfile.web -t phoenix-web:local --load .
FROM nginx:1.27-alpine
COPY --from=webdist . /usr/share/nginx/html
# Runtime nginx config is overridden by the Helm ConfigMap in K8s.
COPY deploy/split/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80