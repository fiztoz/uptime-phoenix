# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# Phoenix — TRULY SPLIT, multi-target build.
#
# Produces three role-specific images from one source tree:
#   --target api     →  phoenix-api    (HTTP + WebSocket only,        distroless)
#   --target worker  →  phoenix-worker (scheduler + checkers + notif, distroless)
#   --target web     →  phoenix-web    (nginx serving the SPA, proxies to api)
#
# Build a single role:
#   docker build -f Dockerfile.split --target api    -t phoenix-api:latest    .
#   docker build -f Dockerfile.split --target worker -t phoenix-worker:latest .
#   docker build -f Dockerfile.split --target web    -t phoenix-web:latest    .
#
# Or let docker-compose.split.yml build and wire all three:
#   docker compose -f docker-compose.split.yml up --build
#
# The all-in-one image (single binary, MODE-switched) lives in ./Dockerfile.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Stage 1: Frontend assets (same strategy as ./Dockerfile) ────────────────
ARG USE_PREBUILT_WEB=0

FROM node:22-alpine AS web-from-source
WORKDIR /app/web
RUN npm install -g bun@1.3.14
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile
COPY web/ ./
RUN npm run build; test -f dist/index.html

FROM alpine:3.20 AS web-from-context
COPY web/dist /app/web/dist
RUN test -f /app/web/dist/index.html

FROM web-from-source AS web-builder-0
FROM web-from-context AS web-builder-1
FROM web-builder-${USE_PREBUILT_WEB} AS web-builder

# ─── Stage 2: Build the Go binaries (CGO-free, static) ───────────────────────
FROM golang:1.25-alpine AS go-builder

# Multi-arch: buildx sets TARGETOS/TARGETARCH; never hardcode amd64.
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG VERSION=dev

RUN apk add --no-cache git
WORKDIR /app
# //go:embed web/dist needs a non-empty dir at compile time even though the web
# tier serves the SPA in split mode. Copying the real build keeps the API binary
# identical to the all-in-one image (it can still serve the UI as a fallback).
# Listed before go mod download to avoid parallel peak RAM with web-builder.
COPY --from=web-builder /app/web/dist ./web/dist
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} GOMAXPROCS=2 \
    go build -trimpath \
      -ldflags="-s -w -X github.com/fiztoz/uptime-phoenix/internal/version.Version=${VERSION}" \
      -o /phoenix-api    ./cmd/api && \
    go build -trimpath \
      -ldflags="-s -w -X github.com/fiztoz/uptime-phoenix/internal/version.Version=${VERSION}" \
      -o /phoenix-worker ./cmd/worker

# ─── Target: api ─── HTTP + WebSocket front door (stateless, scale-out) ──────
FROM gcr.io/distroless/static-debian12:nonroot AS api
ARG VERSION=dev
LABEL org.opencontainers.image.title="Phoenix API" \
      org.opencontainers.image.source="https://github.com/Fiztoz/phoenix" \
      org.opencontainers.image.version="${VERSION}"
COPY --from=go-builder /phoenix-api /phoenix-api
EXPOSE 3000
USER 65532
# cmd/api hard-codes MODE=api — no MODE env required.
ENTRYPOINT ["/phoenix-api"]

# ─── Target: worker ─── scheduler + checkers + notifier (no HTTP port) ───────
FROM gcr.io/distroless/static-debian12:nonroot AS worker
ARG VERSION=dev
LABEL org.opencontainers.image.title="Phoenix Worker" \
      org.opencontainers.image.source="https://github.com/Fiztoz/phoenix" \
      org.opencontainers.image.version="${VERSION}"
COPY --from=go-builder /phoenix-worker /phoenix-worker
USER 65532
# cmd/worker hard-codes MODE=worker.
ENTRYPOINT ["/phoenix-worker"]

# ─── Target: web ─── nginx serving the SPA + proxying /api and /ws to api ────
FROM nginx:1.27-alpine AS web
ARG VERSION=dev
LABEL org.opencontainers.image.title="Phoenix Web" \
      org.opencontainers.image.source="https://github.com/Fiztoz/phoenix" \
      org.opencontainers.image.version="${VERSION}"
COPY --from=web-builder /app/web/dist /usr/share/nginx/html
COPY deploy/split/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
