# Phoenix — Docker build context exclusions

# Version control
.git
.gitignore

# Secrets / local env (never send into builder layers or cache)
.env
.env.*
!.env.example
.secrets/
*.pem
*.key
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.p12
*.pfx
credentials.json
service-account*.json

# Local databases
*.db
*.sqlite
*.sqlite3
phoenix.db-shm
phoenix.db-wal

# Node
node_modules
web/node_modules
web/.svelte-kit
web/.output
web/.netlify
web/build
# web/dist is allowed so release builds can USE_PREBUILT_WEB=1

# Go build artifacts
bin/
*.exe
*.test
*.out

# Local release dry-run output (can be hundreds of MB)
dist/

# IDE / editor
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Documentation (keep AGENTS.md for CI context)
*.md
!AGENTS.md

# Research (not needed in image)
research/

# Local agent tooling
.pi/
.claude/
tmp/

# CI/CD (not needed in image)
.github/

# Kubernetes (not needed in image — built into binary)
charts/
Makefile
docker-compose.yml
docker-compose.*.yml
.dockerignore
