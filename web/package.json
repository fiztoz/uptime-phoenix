    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-time-format": "^4.0.3",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.1.1",
    "bun-types": "^1.3.14",
    "eslint": "^10.8.0",
