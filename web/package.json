{
  "name": "uptime-phoenix-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test src/lib",
    "test:e2e": "playwright test --config=tests/e2e.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-time-format": "^4.0.3",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.5",
    "bun-types": "^1.4.4",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.29.1",
    "@lucide/svelte": "^1.61.0",
    "bits-ui": "^2.20.2",
    "d3-scale": "^4.0.2",
    "d3-time-format": "^4.1.0",
    "isomorphic-dompurify": "^4.6.0",
    "layercake": "^11.0.0",
    "marked": "^18.1.1",
    "svelte-sonner": "^1.2.1"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
