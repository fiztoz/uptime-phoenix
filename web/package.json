    "d3-time-format": "^4.1.0",
    "isomorphic-dompurify": "^3.19.0",
    "layercake": "^8.4.0",
    "marked": "^18.0.7",
    "svelte-sonner": "^1.0.0",
    "sveltekit-superforms": "^2.30.0",
    "tailwind-merge": "^3.0.0",
